# ============================================================
# Viora Backend — Environment Variables Template
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# --- Database ---
DATABASE_URL=sqlite:///./viora.db
# For PostgreSQL:
# DATABASE_URL=postgresql://user:pass@localhost:5432/viora_db

# --- Security ---
SECRET_KEY=change-this-to-a-random-32-char-string

# --- AI / LLM ---
# Gemini API Key (required for chat assistant — get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# --- External APIs (optional) ---
YOUTUBE_API_KEY=

# --- Search APIs ---
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# --- Logging ---
LOG_LEVEL=INFO
